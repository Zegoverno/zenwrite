{
  "name": "zenwrite",
  "version": "0.3.0",
  "description": "A calm Markdown writing app: live preview, alternatives, ghosts, versions. A standalone PWA, a zen plugin and an MCP App.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:web": "vite build --config shells/web/vite.config.ts",
    "build": "npm run build:ui && npm run build:mcp && npm run build:web",
    "dev": "vite --config shells/web/vite.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p mcp/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:smoke": "node tests/mcp-smoke.mjs",
    "test:pack": "node tests/pack-test.mjs",
    "e2e": "node tests/e2e.mjs && node tests/e2e-host.mjs",
    "check": "npm run typecheck && npm run build && npm run test && npm run test:smoke && npm run test:pack",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "katex": "^0.19.1",
    "yaml": "^2.9.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zegoverno/zenwrite.git"
  },
  "author": "Zegoverno"
}
